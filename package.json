{
  "name": "moonphase-e2e",
  "version": "0.0.0",
  "private": true,
  "description": "Playwright end-to-end tests for the MoonPhase Go web app. Not a runtime dependency of the app.",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.4.1",
    "dotenv": "^17.4.2",
    "typescript": "^7.0.2"
  }
}
