package pages

import (
	"strconv"

	"github.com/sunba23/moonphase/templates/layout"
)

templ onboardingForm(model OnboardingModel) {
	<form id="authForm" hx-post="/onboarding" hx-select="#authForm" hx-swap="outerHTML">
		if model.Error != "" {
			<p class="error">{ model.Error }</p>
		}
		<label>
			Max grade
			<select name="max_grade">
				for _, g := range model.Grades {
					<option value={ g }>{ g }</option>
				}
			</select>
		</label>
		<label>
			Board
			<select name="holdsetup">
				for _, b := range model.Boards {
					<option value={ strconv.Itoa(int(b.Holdsetup)) }>{ b.Name }</option>
				}
			</select>
		</label>
		<label>
			Angle
			<select name="angle">
				for _, a := range model.Angles {
					<option value={ strconv.Itoa(int(a)) }>{ strconv.Itoa(int(a)) }°</option>
				}
			</select>
		</label>
		<button type="submit">Continue</button>
	</form>
}

templ OnboardingPage(model OnboardingModel) {
	@layout.Page("Onboarding", onboardingForm(model))
}
