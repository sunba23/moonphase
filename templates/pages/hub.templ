package pages

import (
	"strconv"

	"github.com/sunba23/moonphase/templates/layout"
)

templ hubContent(m HubModel) {
	<main class="hub">
		<h1>MoonPhase</h1>
		<p class="hub__context">
			{ m.BoardName } · { strconv.Itoa(int(m.Angle)) }° · max { m.MaxGrade }
		</p>
		<button class="hub__start" hx-post="/session" hx-swap="none">Main Session</button>
		<p><a href="/profile">Profile</a></p>
	</main>
}

templ HubPage(m HubModel) {
	@layout.Page("MoonPhase", hubContent(m))
}
