package pages

import "strconv"

templ HistoryListContent(m HistoryListModel) {
	<div class="history">
		<h1>Past sessions</h1>
		if len(m.Sessions) == 0 {
			<div class="history-empty">
				<p>No sessions yet. Your first session shows up here once you end it.</p>
				<p><a class="btn btn--secondary" href="/">Start a session</a></p>
			</div>
		} else {
			<ul class="history-cards">
				for _, s := range m.Sessions {
					<li>
						<a class="card histrow" href={ "/sessions/" + s.ID }>
							<span class="histrow__date">{ s.StartedAt }</span>
							<span class="chips">
								<span class="chip">{ s.BoardName }</span>
								<span class="chip">{ strconv.Itoa(int(s.Angle)) }°</span>
							</span>
							<span class="histrow__count">{ strconv.Itoa(s.ClimbedCount) } problems climbed</span>
						</a>
					</li>
				}
			</ul>
			<nav class="history__nav">
				<a href="/">Back to hub</a>
			</nav>
		}
	</div>
}

templ HistoryDetailContent(m HistoryDetailModel) {
	<div class="history">
		<h1>Session</h1>
		<p class="chips">
			<span class="chip">{ m.StartedAt }</span>
			<span class="chip">{ m.BoardName }</span>
			<span class="chip">{ strconv.Itoa(int(m.Angle)) }°</span>
		</p>
		if len(m.Problems) == 0 {
			<p class="history-empty">No problems climbed in this session.</p>
		} else {
			<ol class="histlist">
				for _, p := range m.Problems {
					<li>
						<a class="card histitem" href={ "/sessions/" + m.SessionID + "/problem/" + strconv.Itoa(p.Seq) }>
							<span class="histitem__name">{ p.Name }</span>
							<span class="chips">
								<span class="chip chip--mono">{ p.Grade }</span>
								<span class="chip">RPE { strconv.Itoa(int(p.RPE)) }</span>
								<span class={ "chip", "chip--" + p.Completion }>{ p.Completion }</span>
							</span>
						</a>
					</li>
				}
			</ol>
		}
		<nav class="history__nav">
			<a href="/sessions">Back to past sessions</a>
			<a href="/">Back to hub</a>
		</nav>
	</div>
}

templ HistoryProblemContent(m HistoryProblemModel) {
	<div class="problem">
		<h1>{ m.Problem.Name }</h1>
		@problemMeta(m.Problem)
		@moonBoardOverlay(m.Problem.BoardYear, m.Problem.Holds)
		@holdsList(m.Problem.Holds)
		<div class="problem__result">
			<p class="problem__result-label">You climbed this</p>
			<p class="chips">
				<span class="chip chip--mono">RPE { strconv.Itoa(int(m.RPE)) }</span>
				<span class={ "chip", "chip--" + m.Completion }>{ m.Completion }</span>
			</p>
		</div>
		<p><a href={ "/sessions/" + m.SessionID }>Back to session</a></p>
	</div>
}
