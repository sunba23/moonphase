package pages

import (
	"strconv"

	"github.com/sunba23/moonphase/templates/layout"
)

templ historyListContent(m HistoryListModel) {
	<main class="hub">
		<h1>Past sessions</h1>
		if len(m.Sessions) == 0 {
			<p>No sessions yet.</p>
			<p><a href="/">Start a Main Session</a></p>
		} else {
			<ul class="history">
				for _, s := range m.Sessions {
					<li>
						<a href={ "/sessions/" + s.ID }>
							{ s.StartedAt } · { s.BoardName } · { strconv.Itoa(int(s.Angle)) }° · { strconv.Itoa(s.ClimbedCount) } problems climbed
						</a>
					</li>
				}
			</ul>
			<p><a href="/">Back to hub</a></p>
		}
	</main>
}

templ HistoryListPage(m HistoryListModel) {
	@layout.Page("Past sessions", historyListContent(m))
}

templ historyDetailContent(m HistoryDetailModel) {
	<main class="hub">
		<h1>Session</h1>
		<p class="history__meta">
			{ m.StartedAt } · { m.BoardName } · { strconv.Itoa(int(m.Angle)) }°
		</p>
		if len(m.Problems) == 0 {
			<p>No problems climbed in this session.</p>
		} else {
			<ol class="history">
				for _, p := range m.Problems {
					<li>
						<a href={ "/sessions/" + m.SessionID + "/problem/" + strconv.Itoa(p.Seq) }>
							{ p.Name } · { p.Grade } · RPE { strconv.Itoa(int(p.RPE)) } · { p.Completion }
						</a>
					</li>
				}
			</ol>
		}
		<p><a href="/sessions">Back to past sessions</a></p>
	</main>
}

templ HistoryDetailPage(m HistoryDetailModel) {
	@layout.Page("Session", historyDetailContent(m))
}

templ historyProblemContent(m HistoryProblemModel) {
	<main class="session">
		<h1>{ m.Problem.Name }</h1>
		<p class="session__meta">
			{ m.Problem.Grade } · { strconv.Itoa(int(m.Problem.Angle)) }° · { m.Problem.BoardYear }
		</p>
		@moonBoardOverlay(m.Problem.BoardYear, m.Problem.Holds)
		<ul class="holds">
			for _, h := range m.Problem.Holds {
				<li>{ h.GridRef } — { holdLabel(h) } <span class="holds__role">({ h.Role })</span></li>
			}
		</ul>
		<p class="history__result">
			You climbed this — RPE { strconv.Itoa(int(m.RPE)) } · { m.Completion }
		</p>
		<p><a href={ "/sessions/" + m.SessionID }>Back to session</a></p>
	</main>
}

templ HistoryProblemPage(m HistoryProblemModel) {
	@layout.Page("Problem", historyProblemContent(m))
}
