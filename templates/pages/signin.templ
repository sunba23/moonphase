package pages

import "github.com/sunba23/moonphase/templates/layout"

templ signinForm(model AuthFormModel) {
	<div class="authcard card">
		<h1>Sign in</h1>
		<p class="authcard__help">Pick up where your training left off.</p>
		<form id="authForm" hx-post="/signin" hx-select="#authForm" hx-swap="outerHTML">
			if model.Error != "" {
				<p class="field-error">{ model.Error }</p>
			}
			<label>
				Email
				<input type="email" name="email" value={ model.Email } required/>
			</label>
			<label>
				Password
				<input type="password" name="password" required/>
			</label>
			<button type="submit" class="btn btn--full">Sign in</button>
		</form>
		<p class="authcard__alt">New to MoonPhase? <a href="/signup">Create an account</a></p>
	</div>
}

templ SigninPage(model AuthFormModel) {
	@layout.Page("Sign in", signinForm(model))
}
