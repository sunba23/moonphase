package pages

import "github.com/sunba23/moonphase/templates/layout"

templ signinForm(model AuthFormModel) {
	<form id="authForm" hx-post="/signin" hx-select="#authForm" hx-swap="outerHTML">
		if model.Error != "" {
			<p class="error">{ model.Error }</p>
		}
		<label>
			Email
			<input type="email" name="email" required/>
		</label>
		<label>
			Password
			<input type="password" name="password" required/>
		</label>
		<button type="submit">Sign in</button>
	</form>
}

templ SigninPage(model AuthFormModel) {
	@layout.Page("Sign in", signinForm(model))
}
