package pages

import (
	"strconv"

	"github.com/sunba23/moonphase/templates/layout"
)

templ profileForm(model ProfileModel) {
	<form id="authForm" hx-post="/profile" hx-select="#authForm" hx-swap="outerHTML">
		if model.Error != "" {
			<p class="error">{ model.Error }</p>
		}
		<label>
			Max grade
			<select name="max_grade">
				for _, g := range model.Grades {
					<option value={ g } selected?={ g == model.CurrentGrade }>{ g }</option>
				}
			</select>
		</label>
		<label>
			Board
			<select name="holdsetup">
				for _, b := range model.Boards {
					<option value={ strconv.Itoa(int(b.Holdsetup)) } selected?={ b.Holdsetup == model.CurrentHoldsetup }>{ b.Name }</option>
				}
			</select>
		</label>
		<label>
			Angle
			<select name="angle">
				for _, a := range model.Angles {
					<option value={ strconv.Itoa(int(a)) } selected?={ a == model.CurrentAngle }>{ strconv.Itoa(int(a)) }°</option>
				}
			</select>
		</label>
		<button type="submit">Save</button>
	</form>
}

templ ProfilePage(model ProfileModel) {
	@layout.Page("Profile", profileForm(model))
}
