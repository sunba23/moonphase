package pages

import "strconv"

templ ProfileForm(model ProfileModel) {
	<div class="profile">
		<h1>Profile</h1>
		<form class="card" id="authForm" hx-post="/profile" hx-select="#authForm" hx-swap="outerHTML">
			if model.Error != "" {
				<p class="field-error">{ model.Error }</p>
			}
			<label>
				Max grade
				<select name="max_grade">
					for _, g := range model.Grades {
						<option value={ g } selected?={ g == model.CurrentGrade }>{ g }</option>
					}
				</select>
			</label>
			<label>
				Board
				<select name="holdsetup">
					for _, b := range model.Boards {
						<option value={ strconv.Itoa(int(b.Holdsetup)) } selected?={ b.Holdsetup == model.CurrentHoldsetup }>{ b.Name }</option>
					}
				</select>
			</label>
			<label>
				Angle
				<select name="angle">
					for _, a := range model.Angles {
						<option value={ strconv.Itoa(int(a)) } selected?={ a == model.CurrentAngle }>{ strconv.Itoa(int(a)) }°</option>
					}
				</select>
			</label>
			<button type="submit" class="btn btn--full">Save</button>
		</form>
		<form class="signout" hx-post="/signout" hx-swap="none">
			<button type="submit" class="btn btn--secondary btn--full">Sign out</button>
		</form>
		<form
			class="delete-account"
			hx-post="/account/delete"
			hx-swap="none"
			hx-confirm="This permanently deletes your account, every session, and every rating. This cannot be undone. Continue?"
		>
			<button type="submit" class="btn btn--danger btn--full">Delete account</button>
		</form>
	</div>
}
