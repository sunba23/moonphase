package pages

import (
	"fmt"
	"strconv"
	"strings"

	"github.com/sunba23/moonphase/internal/catalog"
	"github.com/sunba23/moonphase/templates/layout"
)

// holdLabel renders a hold's type tag plus any modifiers, e.g.
// "crimp (sharp, incut)" or "untagged".
func holdLabel(h catalog.HoldPlacement) string {
	label := h.PrimaryType
	if label == "" {
		label = "untagged"
	}
	if len(h.Modifiers) > 0 {
		label += " (" + strings.Join(h.Modifiers, ", ") + ")"
	}
	return label
}

templ holdMarker(year string, h catalog.HoldPlacement) {
	{{ x, y := catalog.HoldXY(year, h.Col, h.Row) }}
	<span
		class={ "hold", "hold--" + h.Role }
		style={ templ.SafeCSS(fmt.Sprintf("left:%.2f%%;top:%.2f%%", x, y)) }
		title={ h.GridRef }
	></span>
}

templ moonBoardOverlay(year string, holds []catalog.HoldPlacement) {
	<div class="board">
		<img class="board__img" src={ "/static/moonboard/" + year + ".jpg" } alt={ "MoonBoard " + year }/>
		for _, h := range holds {
			@holdMarker(year, h)
		}
	</div>
}

// problemMeta renders the grade / angle / board-year chips shown under a
// problem name. The grade chip carries a test hook — three plain-text chips
// are ambiguous to a role/label locator.
templ problemMeta(p catalog.ProblemView) {
	<p class="chips">
		<span class="chip chip--mono" data-testid="card-grade">{ p.Grade }</span>
		<span class="chip">{ strconv.Itoa(int(p.Angle)) }°</span>
		<span class="chip">{ p.BoardYear }</span>
	</p>
}

templ holdsList(holds []catalog.HoldPlacement) {
	<ul class="holds">
		for _, h := range holds {
			<li class="holds__item">
				<span class="holds__ref">{ h.GridRef }</span>
				<span class="holds__type">{ holdLabel(h) }</span>
				<span class="holds__role">{ h.Role }</span>
			</li>
		}
	</ul>
}

templ resultForm(sessionID string, seq int) {
	<form
		class="result"
		hx-post={ "/session/" + sessionID + "/result" }
		hx-target="#session-card"
		hx-swap="outerHTML"
	>
		<input type="hidden" name="seq" value={ strconv.Itoa(seq) }/>
		<fieldset class="result__status">
			<legend>How did it go?</legend>
			<div class="result__status-row">
				<label><input type="radio" name="completion" value="sent" required/> Sent</label>
				<label><input type="radio" name="completion" value="failed" required/> Failed</label>
				<label><input type="radio" name="completion" value="bailed" required/> Bailed</label>
			</div>
		</fieldset>
		<div class="result__rpe" role="group" aria-label="Rate the effort, 1 to 10">
			for n := 1; n <= 10; n++ {
				<button type="submit" name="rpe" value={ strconv.Itoa(n) }>{ strconv.Itoa(n) }</button>
			}
		</div>
	</form>
}

templ SessionCard(m SessionCardModel) {
	<div id="session-card" class="session session--live">
		<div class="session__scroll">
			<h1>{ m.Problem.Name }</h1>
			@problemMeta(m.Problem)
			@moonBoardOverlay(m.Problem.BoardYear, m.Problem.Holds)
			@holdsList(m.Problem.Holds)
		</div>
		<div class="session__actions">
			@resultForm(m.SessionID, m.Seq)
			<form class="session__end" hx-post={ "/session/" + m.SessionID + "/end" } hx-swap="none">
				<button type="submit" class="btn btn--secondary btn--full">End session</button>
			</form>
		</div>
	</div>
}

templ SessionPage(m SessionModel) {
	@layout.Page("Session", SessionCard(m.Card))
}

templ UnsupportedBoardContent(m UnsupportedBoardModel) {
	<div class="notice">
		<h1>Switch your board</h1>
		<p>
			Your profile is set to { m.BoardName }, which MoonPhase can't run a session on
			yet. Choose 2016 or 2024 in your profile to start a session.
		</p>
		<p><a class="btn btn--secondary" href="/profile">Go to Profile</a></p>
	</div>
}

templ UnsupportedBoardPage(m UnsupportedBoardModel) {
	@layout.Page("Switch your board", UnsupportedBoardContent(m))
}
