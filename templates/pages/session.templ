package pages

import (
	"fmt"
	"strconv"
	"strings"

	"github.com/sunba23/moonphase/internal/catalog"
	"github.com/sunba23/moonphase/templates/layout"
)

// pct returns n as an integer percentage of max, clamped to [0, 100]. A
// non-positive max or n yields 0.
func pct(n, max int) int {
	if max <= 0 || n <= 0 {
		return 0
	}
	if n >= max {
		return 100
	}
	return n * 100 / max
}

// holdLabel renders a hold's type tag plus any modifiers, e.g.
// "crimp (sharp, incut)" or "untagged".
func holdLabel(h catalog.HoldPlacement) string {
	label := h.PrimaryType
	if label == "" {
		label = "untagged"
	}
	if len(h.Modifiers) > 0 {
		label += " (" + strings.Join(h.Modifiers, ", ") + ")"
	}
	return label
}

templ holdMarker(year string, h catalog.HoldPlacement) {
	{{ x, y := catalog.HoldXY(year, h.Col, h.Row) }}
	<span
		class={ "hold", "hold--" + h.Role }
		style={ templ.SafeCSS(fmt.Sprintf("left:%.2f%%;top:%.2f%%", x, y)) }
		title={ h.GridRef }
	></span>
}

templ moonBoardOverlay(year string, holds []catalog.HoldPlacement) {
	<div class="board">
		<img class="board__img" src={ "/static/moonboard/" + year + ".jpg" } alt={ "MoonBoard " + year }/>
		for _, h := range holds {
			@holdMarker(year, h)
		}
	</div>
}

// problemMeta renders the grade / angle / board-year chips shown under a
// problem name. The grade chip carries a test hook — three plain-text chips
// are ambiguous to a role/label locator.
templ problemMeta(p catalog.ProblemView) {
	<p class="chips">
		<span class="chip chip--mono" data-testid="card-grade">{ p.Grade }</span>
		<span class="chip">{ strconv.Itoa(int(p.Angle)) }°</span>
		<span class="chip">{ p.BoardYear }</span>
	</p>
}

templ holdsList(holds []catalog.HoldPlacement) {
	<ul class="holds">
		for _, h := range holds {
			<li class="holds__item">
				<span class="holds__ref">{ h.GridRef }</span>
				<span class="holds__type">{ holdLabel(h) }</span>
				<span class="holds__role">{ h.Role }</span>
			</li>
		}
	</ul>
}

// holdsPanel wraps the per-hold breakdown in an openable panel, sitting above
// the Session-balance panel. Closed by default — the board is the primary
// view; the text breakdown is there when the climber wants it.
templ holdsPanel(holds []catalog.HoldPlacement) {
	<details class="panel">
		<summary class="panel__summary">
			<span class="panel__summary-label">
				@iconHolds()
				Holds
			</span>
		</summary>
		@holdsList(holds)
	</details>
}

// iconHolds / iconBalance are the small leading glyphs on the two panel
// summaries. Decorative only (aria-hidden); the summary text is the label.
templ iconHolds() {
	<svg class="panel__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
		<circle cx="5" cy="7" r="1.3" fill="currentColor" stroke="none"></circle>
		<circle cx="5" cy="12" r="1.3" fill="currentColor" stroke="none"></circle>
		<circle cx="5" cy="17" r="1.3" fill="currentColor" stroke="none"></circle>
		<path d="M10 7h9M10 12h9M10 17h9" stroke-linecap="round"></path>
	</svg>
}

templ iconBalance() {
	<svg class="panel__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
		<path d="M4 20h16" stroke-linecap="round"></path>
		<rect x="5.5" y="12" width="3.6" height="6" rx="0.6"></rect>
		<rect x="10.2" y="7" width="3.6" height="11" rx="0.6"></rect>
		<rect x="14.9" y="14.5" width="3.6" height="3.5" rx="0.6"></rect>
	</svg>
}

templ resultForm(sessionID string, seq int) {
	<form
		class="result"
		hx-post={ "/session/" + sessionID + "/result" }
		hx-target="#session-card"
		hx-swap="outerHTML"
	>
		<input type="hidden" name="seq" value={ strconv.Itoa(seq) }/>
		<fieldset class="result__status">
			<legend>How did it go?</legend>
			<div class="result__status-row">
				<label class="result__opt result__opt--sent"><input type="radio" name="completion" value="sent" required/> Sent</label>
				<label class="result__opt result__opt--failed"><input type="radio" name="completion" value="failed" required/> Failed</label>
				<button
					type="submit"
					class="result__opt result__opt--skip"
					hx-post={ "/session/" + sessionID + "/skip" }
					hx-target="#session-card"
					hx-swap="outerHTML"
					formnovalidate
				>
					Skip
				</button>
			</div>
		</fieldset>
		<div class="result__rpe" role="group" aria-label="Rate the effort, 1 to 10">
			for n := 1; n <= 10; n++ {
				<button type="submit" name="rpe" value={ strconv.Itoa(n) }>
					@rpeFace(n)
					<span class="rpe__num">{ strconv.Itoa(n) }</span>
				</button>
			}
		</div>
	</form>
}

// rpeFace draws a simple effort face for an RPE value — relaxed at the low
// end, straining at the top. Decorative only (aria-hidden); the button's
// accessible name stays the bare digit.
templ rpeFace(n int) {
	<svg class="rpe__face" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
		<circle cx="12" cy="12" r="9"></circle>
		<circle cx="9" cy="10" r="0.7" fill="currentColor" stroke="none"></circle>
		<circle cx="15" cy="10" r="0.7" fill="currentColor" stroke="none"></circle>
		switch  {
			case n <= 3:
				<path d="M8.5 14.3c1 1.2 2.1 1.8 3.5 1.8s2.5-.6 3.5-1.8" stroke-linecap="round"></path>
			case n <= 6:
				<path d="M8.5 15h7" stroke-linecap="round"></path>
			case n <= 8:
				<path d="M8.5 15.9c1-1 2.1-1.5 3.5-1.5s2.5.5 3.5 1.5" stroke-linecap="round"></path>
			default:
				<path d="M8.2 16.2c1-1.5 2.3-2.2 3.8-2.2s2.8.7 3.8 2.2" stroke-linecap="round"></path>
				<path d="M7.6 8.2l2.2 1.1M16.4 8.2l-2.2 1.1" stroke-linecap="round"></path>
		}
	</svg>
}

// sessionPanel is the collapsed "Session balance" surface below the board: the
// session-so-far hold-type tally plus a terse, non-prose rationale for the
// current pick. Closed by default so the board stays the primary view.
templ sessionPanel(p SessionPanel) {
	<details class="panel">
		<summary class="panel__summary">
			<span class="panel__summary-label">
				@iconBalance()
				Session balance
			</span>
		</summary>
		if p.GradeTag != "" {
			<p class="panel__why">
				<span class="chip">{ p.GradeTag }</span>
				if p.HoldTag != "" {
					<span class="chip">{ p.HoldTag }</span>
				}
			</p>
		}
		<ul class="panel__bars">
			for _, b := range p.Bars {
				<li class="panel__bar">
					<span class="panel__bar-label">{ b.Type }</span>
					<span class="panel__bar-track">
						<span
							class="panel__bar-fill"
							style={ templ.SafeCSS(fmt.Sprintf("width:%d%%", pct(b.Count, p.MaxCount))) }
						></span>
					</span>
					<span class="panel__bar-count">{ strconv.Itoa(b.Count) }</span>
				</li>
			}
		</ul>
	</details>
}

templ SessionCard(m SessionCardModel) {
	<div id="session-card" class="session session--live">
		<div class="session__scroll">
			<h1>{ m.Problem.Name }</h1>
			@problemMeta(m.Problem)
			@moonBoardOverlay(m.Problem.BoardYear, m.Problem.Holds)
			@holdsPanel(m.Problem.Holds)
			if m.Panel != nil {
				@sessionPanel(*m.Panel)
			}
		</div>
		<div class="session__actions">
			@resultForm(m.SessionID, m.Seq)
			<form class="session__end" hx-post={ "/session/" + m.SessionID + "/end" } hx-swap="none">
				<button type="submit" class="btn btn--secondary btn--full">End session</button>
			</form>
		</div>
	</div>
}

templ SessionPage(m SessionModel) {
	@layout.Page("Session", SessionCard(m.Card))
}

templ UnsupportedBoardContent(m UnsupportedBoardModel) {
	<div class="notice">
		<h1>Switch your board</h1>
		<p>
			Your profile is set to { m.BoardName }, which MoonPhase can't run a session on
			yet. Choose 2016 or 2024 in your profile to start a session.
		</p>
		<p><a class="btn btn--secondary" href="/profile">Go to Profile</a></p>
	</div>
}

templ UnsupportedBoardPage(m UnsupportedBoardModel) {
	@layout.Page("Switch your board", UnsupportedBoardContent(m))
}
